VITE_SIGNALING_URL=wss://realtimerivals-backend.onrender.com/ws

# TURN relay, needed when players are on different networks or the same router.
# This file is committed, so put the real values in .env.local (git-ignored)
# locally, and in the hosting dashboard for the deployed site:
#   VITE_TURN_URLS=turn:host:3478,turns:host:443?transport=tcp
#   VITE_TURN_USERNAME=...
#   VITE_TURN_CREDENTIAL=...
